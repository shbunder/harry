# digest_list_candidates — Everything today could contain — the weather, the agenda and the headlines, in one call
#
# GENERATED by `make env-template` from TOOL.md. Do not edit this file.
#
# Your values go in `.env.local` beside it, which is gitignored. Put in only what
# differs — everything else still comes from here, and from the defaults in the
# declaration. Any key can also be overridden from the environment, which is how a
# container injects one; the override name is noted beside each key.


# Feed slugs that are local papers, separated by |. A story from one of these counts only when it names a place in nearby_places. Empty means no feed is treated as local.
#   default: ''
#   override: HARRY_DIGEST_LIST_CANDIDATES_NEARBY_FEEDS
NEARBY_FEEDS=

# The places a local story must name to be worth handing over, separated by |. Matched against the title and the summary, case-insensitively.
#   default: ''
#   override: HARRY_DIGEST_LIST_CANDIDATES_NEARBY_PLACES
NEARBY_PLACES=

# How many local stories to hand over at most. They go last in the list, after everything else.
#   default: 5
#   override: HARRY_DIGEST_LIST_CANDIDATES_NEARBY_LIMIT
NEARBY_LIMIT=5
