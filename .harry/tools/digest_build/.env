# digest_build — Build the morning page from the stories you chose, and put it on the tablet
#
# GENERATED by `make env-template` from TOOL.md. Do not edit this file.
#
# Your values go in `.env.local` beside it, which is gitignored. Put in only what
# differs — everything else still comes from here, and from the defaults in the
# declaration. Any key can also be overridden from the environment, which is how a
# container injects one; the override name is noted beside each key.


# What the journal calls itself, on the masthead
#   default: 'The Morning Page'
#   override: HARRY_DIGEST_BUILD_NAME
export NAME=The Morning Page

# Which ink each calendar is drawn in — Shaun=yellow|Kids=pink. One of yellow, green, pink, blue, red, purple, grey; a calendar nobody names gets grey
#   default: ''
#   override: HARRY_DIGEST_BUILD_COLOURS
export COLOURS=

# Which folder on the tablet the page goes into. Empty means wherever the tablet connector puts things
#   default: ''
#   override: HARRY_DIGEST_BUILD_FOLDER
export FOLDER=

# Where the PDF is written. It stays there whether or not a tablet took it
#   default: '/data/digest'
#   override: HARRY_DIGEST_BUILD_OUT_DIR
export OUT_DIR=/data/digest

# Which day "today" means, and the clock the timetable prints
#   default: 'Europe/Brussels'
#   override: HARRY_DIGEST_BUILD_TIMEZONE
export TIMEZONE=Europe/Brussels
