# news — Headlines from public news feeds, and the full text of a story you pick
#
# GENERATED by `make env-template` from CONNECTOR.md. Do not edit this file.
#
# Your values go in `.env.local` beside it, which is gitignored. Put in only what
# differs — everything else still comes from here, and from the defaults in the
# declaration. Any key can also be overridden from the environment, which is how a
# container injects one; the override name is noted beside each key.


# Every feed, separated by |. Each is slug=Name=url, split on the first two = so a URL can carry as many more as it likes. The slug starts every id from that feed; the Name is what a person reads.
#   default: 'vrt=VRT NWS=https://www.vrt.be/vrtnws/nl.rss.articles.xml|bbc=BBC News=https://feeds.bbci.co.uk/news/rss.xml'
#   override: HARRY_NEWS_FEEDS
FEEDS=vrt=VRT NWS=https://www.vrt.be/vrtnws/nl.rss.articles.xml|bbc=BBC News=https://feeds.bbci.co.uk/news/rss.xml

# An IANA zone. Decides which day a story is filed under, so "today" means the day where the page is read rather than in UTC.
#   default: 'Europe/Brussels'
#   override: HARRY_NEWS_TIMEZONE
TIMEZONE=Europe/Brussels
