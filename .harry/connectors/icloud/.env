# icloud — Your calendar — what today looks like, from iCloud over CalDAV
#
# GENERATED by `make env-template` from CONNECTOR.md. Do not edit this file.
#
# Your values go in `.env.local` beside it, which is gitignored. Put in only what
# differs — everything else still comes from here, and from the defaults in the
# declaration. Any key can also be overridden from the environment, which is how a
# container injects one; the override name is noted beside each key.


# The Apple ID the calendar belongs to, usually an email address.
#   required
#   override: HARRY_ICLOUD_USERNAME
USERNAME=

# An app-specific password from account.apple.com → Sign-In and Security → App-Specific Passwords. Shown once. Needs two-factor turned on. Looks like abcd-efgh-ijkl-mnop.
#   required · SECRET — leave empty here, set it in .env.local
#   override: HARRY_ICLOUD_APP_PASSWORD
APP_PASSWORD=

# Which iCloud calendars to read, by name, comma-separated. Empty means all of them — which is the right answer for most accounts.
#   default: ''
#   override: HARRY_ICLOUD_CALENDARS
CALENDARS=

# Published calendar links to read alongside iCloud, as Name=url separated by |. A link like this IS the credential — anyone holding it can read that calendar — so it belongs only in .env.local, and it is revoked by republishing the calendar in Outlook. Unset means iCloud only.
#   SECRET — leave empty here, set it in .env.local
#   override: HARRY_ICLOUD_SUBSCRIBED
SUBSCRIBED=

# An IANA zone, so "today" and the times on the page mean the time in the room rather than in UTC.
#   default: 'Europe/Brussels'
#   override: HARRY_ICLOUD_TIMEZONE
TIMEZONE=Europe/Brussels
