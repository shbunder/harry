# weather — Today's forecast for one place, from Open-Meteo, with no account and no key
#
# GENERATED by `make env-template` from CONNECTOR.md. Do not edit this file.
#
# Your values go in `.env.local` beside it, which is gitignored. Put in only what
# differs — everything else still comes from here, and from the defaults in the
# declaration. Any key can also be overridden from the environment, which is how a
# container injects one; the override name is noted beside each key.


# Decimal degrees north. Leuven is 50.88. Look a place up once at open-meteo.com rather than making Harry geocode it every morning.
#   default: 50.88
#   override: HARRY_WEATHER_LATITUDE
LATITUDE=50.88

# Decimal degrees east. Leuven is 4.70.
#   default: 4.7
#   override: HARRY_WEATHER_LONGITUDE
LONGITUDE=4.7

# An IANA zone, so "today" means the day where the page is read rather than in UTC.
#   default: 'Europe/Brussels'
#   override: HARRY_WEATHER_TIMEZONE
TIMEZONE=Europe/Brussels

# What to call this spot on the page and in an answer. Open-Meteo never sees it.
#   default: 'Leuven'
#   override: HARRY_WEATHER_PLACE
PLACE=Leuven
