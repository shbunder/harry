# remarkable — The reMarkable tablet — where a finished page ends up
#
# GENERATED by `make env-template` from CONNECTOR.md. Do not edit this file.
#
# Your values go in `.env.local` beside it, which is gitignored. Put in only what
# differs — everything else still comes from here, and from the defaults in the
# declaration. Any key can also be overridden from the environment, which is how a
# container injects one; the override name is noted beside each key.


# The long token from pairing. Get it with: make remarkable-pair CODE=<the 8 characters from my.remarkable.com/device/desktop/connect>. It does not expire, but revoking the device at my.remarkable.com kills it.
#   required · SECRET — leave empty here, set it in .env.local
#   override: HARRY_REMARKABLE_DEVICE_TOKEN
DEVICE_TOKEN=

# Which folder on the tablet documents go into. Created at the top level the first time, if it is not already there.
#   default: 'Harry'
#   override: HARRY_REMARKABLE_FOLDER
FOLDER=Harry
