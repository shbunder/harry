# tijd — De Tijd's articles, read the way a subscriber reads them — in a logged-in browser
#
# GENERATED by `make env-template` from CONNECTOR.md. Do not edit this file.
#
# Your values go in `.env.local` beside it, which is gitignored. Put in only what
# differs — everything else still comes from here, and from the defaults in the
# declaration. Any key can also be overridden from the environment, which is how a
# container injects one; the override name is noted beside each key.


# The email address the De Tijd subscription signs in with. An account that signs in with Google or Apple has no password Harry can use.
#   required · SECRET — leave empty here, set it in .env.local
#   override: HARRY_TIJD_EMAIL
EMAIL=

# That account's De Tijd password. Used only when the saved session has lapsed, and never twice within 6 hours after De Tijd refuses it — De Tijd blocks an account after repeated failures.
#   required · SECRET — leave empty here, set it in .env.local
#   override: HARRY_TIJD_PASSWORD
PASSWORD=

# Where the logged-in session is saved. Keep it on the data volume and nowhere else — the file is a working De Tijd login for anyone who has it.
#   default: '/data/tijd'
#   override: HARRY_TIJD_SESSION_DIR
SESSION_DIR=/data/tijd
