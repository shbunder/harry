# Harry — core's own settings. THIS FILE IS COMMITTED.
#
# Two files, and the split is the point:
#
#   .env         this file. Committed. Every key CORE has, with its working default.
#                Secrets are left empty.
#   .env.local   yours. Gitignored. The real secrets, plus anything that differs on
#                this machine — a port, a data directory.
#
# You do not copy this file. You create `.env.local` beside it and put in only what
# differs. Precedence, highest first:
#
#   1. a real environment variable    HARRY_PORT=7431 make serve
#   2. .env.local                     this machine
#   3. .env                           this file
#
# `harry/config.py` declares all of it, typed, and reads both files in that order.
# Nothing reads the environment outside it, and the Makefile does not load this file —
# that is what makes the order above true rather than aspirational.
#
# The `export` prefixes let this file be `source`d by hand. Both readers strip them before
# the value is used — pydantic's dotenv parser and Docker Compose's `env_file` — so they
# change nothing about the order above.
#
# THE ONE KEY THAT MAY NOT BE EXPORTED IS AN EMPTY ONE. `export` puts a value in the
# process environment, which outranks `.env.local`. So `export HARRY_API_TOKEN=` here,
# once anybody sources this file, sets the token to empty for everything downstream and
# the real one in `.env.local` is never read — resolving to "nobody is authorised", with
# nothing saying why. A key carrying a real default is safe: sourcing it just reproduces
# the default. `tests/test_config.py` fails on an exported empty key.
#
# A CAPABILITY'S SETTINGS ARE NOT HERE. Each one carries its own `.env` pair inside
# its folder — `.harry/connectors/icloud/.env` and `.env.local` beside it — with bare
# keys, because the folder is the namespace. Those files are generated from the
# capability's `config:` block by `make env-template`; never hand-write one.
# See .claude/rules/secrets-and-config.md.

# ---- Core -------------------------------------------------------------------
#
# Comments go ABOVE a key, never after it. An inline comment following an EMPTY value
# is read as the value — `HARRY_API_TOKEN=   # generate with openssl` resolved to the
# string "# generate with openssl", which meant an unconfigured Harry had a bearer
# token published in this file. Found by a test, not by anything failing.

# Marcel owns 7420/7421. Do not collide.
export HARRY_PORT=7430

# SQLite, rendered pages, cached articles, and each person's own settings.
export HARRY_DATA_DIR=/data

# The MCP bearer token. Generate: openssl rand -hex 32
# Empty means nobody is authorised, which is the safe default and is asserted.
HARRY_API_TOKEN=

# https://harry.<your-domain> — the tunnel hostname. Empty means localhost only.
HARRY_PUBLIC_URL=

# Optional: a directory of out-of-tree capabilities, loaded after this instance's own.
HARRY_CAPABILITIES_DIR=

export HARRY_LOG_LEVEL=INFO

# The scheduler's timezone. 06:30 is a local time, not a UTC one.
export HARRY_LOCATION_TZ=Europe/Brussels

# Whether this instance runs the clock. The real stack leaves this true; a second stack
# beside it on the same machine sets it false, so only one Harry watches the deadlines.
# Two watchdogs would both report a missed morning and one of them would be wrong.
export HARRY_SCHEDULER_ENABLED=true
